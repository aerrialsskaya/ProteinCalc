<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <title>Protein Pro</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        :root { --primary: #4f46e5; --bg: #f8fafc; }
        body { background-color: var(--bg); touch-action: manipulation; -webkit-tap-highlight-color: transparent; }
        .app-container { max-width: 450px; margin: 0 auto; }
        .input-card { background: white; border-radius: 28px; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.05); }
        input::-webkit-outer-spin-button, input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
        .history-item { animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
        @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    </style>
</head>
<body class="min-h-screen flex items-start justify-center pt-6 px-4 pb-20">

    <div class="app-container w-full space-y-6">
        <!-- Header -->
        <div class="flex items-center justify-between px-2">
            <div>
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">PROTEIN<span class="text-indigo-600">.</span></h1>
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em]">Smart Calculator</p>
            </div>
            <button onclick="window.location.reload()" class="h-10 w-10 bg-white rounded-2xl flex items-center justify-center shadow-sm border border-slate-100">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
            </button>
        </div>

        <!-- Result Display -->
        <div id="result-box" class="bg-indigo-600 rounded-[32px] p-8 text-white shadow-2xl shadow-indigo-200 relative overflow-hidden transition-all duration-300">
            <div class="relative z-10">
                <p class="text-indigo-200 text-xs font-bold mb-1 uppercase tracking-widest opacity-80">Белка в вашей порции</p>
                <div class="flex items-baseline">
                    <span id="res" class="text-6xl font-black tracking-tighter">0.0</span>
                    <span class="text-2xl font-bold ml-2 text-indigo-100/50">г</span>
                </div>
            </div>
            <div class="absolute -right-6 -top-6 w-32 h-32 bg-indigo-500 rounded-full blur-2xl opacity-40"></div>
        </div>

        <!-- Form -->
        <div class="input-card p-6 space-y-5 border border-slate-100">
            <div class="space-y-2">
                <div class="flex justify-between items-center ml-1">
                    <label class="text-[11px] font-black text-slate-400 uppercase tracking-wider">Белок на 100г (Y)</label>
                    <span id="y-val" class="text-[11px] font-bold text-indigo-500 bg-indigo-50 px-2 py-0.5 rounded-full hidden">0г</span>
                </div>
                <input type="number" id="y" inputmode="decimal" placeholder="0.0" 
                    class="w-full bg-slate-50 border-2 border-transparent focus:border-indigo-100 rounded-2xl py-4 px-5 text-xl font-bold transition-all outline-none text-slate-800 placeholder:text-slate-300">
            </div>

            <div class="space-y-2">
                <div class="flex justify-between items-center ml-1">
                    <label class="text-[11px] font-black text-slate-400 uppercase tracking-wider">Вес порции (г) (Z)</label>
                    <span id="z-val" class="text-[11px] font-bold text-indigo-500 bg-indigo-50 px-2 py-0.5 rounded-full hidden">0г</span>
                </div>
                <input type="number" id="z" inputmode="numeric" placeholder="0" 
                    class="w-full bg-slate-50 border-2 border-transparent focus:border-indigo-100 rounded-2xl py-4 px-5 text-xl font-bold transition-all outline-none text-slate-800 placeholder:text-slate-300">
            </div>
        </div>

        <!-- History Section -->
        <div id="history-section" class="space-y-4 px-1 pb-10">
            <div class="flex justify-between items-center">
                <h2 class="text-xs font-black text-slate-400 uppercase tracking-[0.2em]">Последние замеры</h2>
                <button onclick="clearHistory()" class="h-8 w-8 flex items-center justify-center rounded-xl bg-slate-100 text-slate-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                </button>
            </div>
            <div id="history-list" class="space-y-3 text-center py-4 text-slate-300 font-medium text-sm italic">
                История пуста
            </div>
        </div>
    </div>

    <script>
        const yInput = document.getElementById('y');
        const zInput = document.getElementById('z');
        const resDisplay = document.getElementById('res');
        const resultBox = document.getElementById('result-box');
        const historyList = document.getElementById('history-list');

        let history = JSON.parse(localStorage.getItem('protein_history')) || [];
        let saveTimer;

        function init() {
            renderHistory();
        }

        function update() {
            const y = parseFloat(yInput.value) || 0;
            const z = parseFloat(zInput.value) || 0;
            
            if (y === 0 || z === 0) {
                resDisplay.innerText = "0.0";
                return;
            }

            const result = (y / 100) * z;
            const formattedResult = result % 1 === 0 ? result.toFixed(0) : result.toFixed(1);
            
            resDisplay.innerText = formattedResult;
            
            resultBox.style.transform = "scale(1.02)";
            setTimeout(() => resultBox.style.transform = "scale(1)", 150);

            clearTimeout(saveTimer);
            saveTimer = setTimeout(() => addToHistory(y, z, formattedResult), 2000);
        }

        function addToHistory(y, z, x) {
            const entry = { y, z, x, id: Date.now() };
            // Проверка на дубликат (последний замер такой же)
            if (history.length > 0 && history[0].y === y && history[0].z === z) return;
            
            history.unshift(entry);
            history = history.slice(0, 10); // Храним 10 записей
            localStorage.setItem('protein_history', JSON.stringify(history));
            renderHistory();
        }

        function renderHistory() {
            if (history.length === 0) {
                historyList.innerHTML = '<div class="py-8 text-slate-300 italic text-xs">Нет сохраненных расчетов</div>';
                return;
            }

            historyList.innerHTML = history.map(item => `
                <div class="history-item bg-white border border-slate-100 p-4 rounded-2xl flex justify-between items-center shadow-sm">
                    <div class="flex items-center space-x-4">
                        <div class="h-10 w-10 bg-indigo-50 rounded-xl flex items-center justify-center text-indigo-500 font-black text-xs">
                            ${Math.round(item.y)}
                        </div>
                        <div>
                            <p class="text-xs font-black text-slate-800">${item.z} грамм</p>
                            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-tighter">Порция продукта</p>
                        </div>
                    </div>
                    <div class="bg-slate-50 px-3 py-2 rounded-xl border border-slate-100">
                        <span class="text-lg font-black text-indigo-600">${item.x}<span class="text-[10px] ml-0.5">г</span></span>
                    </div>
                </div>
            `).join('');
        }

        function clearHistory() {
            history = [];
            localStorage.removeItem('protein_history');
            renderHistory();
        }

        yInput.addEventListener('input', update);
        zInput.addEventListener('input', update);
        window.onload = init;
    </script>
</body>
</html>

